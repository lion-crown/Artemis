#!/bin/bash
# Artemis — 卸载前回调
# 根据卸载向导 wizard_delete_data 的选择：
#   - 保留数据：不清理 /vol1/@appshare/artemis/data。
#   - 完全删除：在 uninstall_callback 中清理 data-share。
# 同时释放 Artemis 端口（8088=Docker 版，8089=本地版），避免卸载后残留进程占端口。
set -euo pipefail

# 共享函数库（find_python312 / fix_ownership_and_perms / free_artemis_ports）
# 打包时由 scripts/build-fpk.sh 注入；仓库内运行无此文件时跳过（函数缺失时再报错）。
_ARTEMIS_COMMON=""$(dirname "$0")/common.sh""
[ -f "$_ARTEMIS_COMMON" ] && source "$_ARTEMIS_COMMON"

log() { echo "[artemis] $1" > "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true; }



free_artemis_ports

if [ "${wizard_delete_data:-no}" = "yes" ]; then
    log "用户选择完全删除数据，将在 uninstall_callback 中清理 /vol1/@appshare/artemis/data"
else
    log "用户选择保留数据，/vol1/@appshare/artemis/data 将保留"
fi

exit 0
